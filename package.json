    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "swagger-stats": "^0.99.7",
    "typescript-transform-paths": "^3.5.6",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },

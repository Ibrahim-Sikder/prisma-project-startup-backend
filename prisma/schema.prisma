generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum ListingStatus {
  DRAFT
  PREVIEW
  PAID
  UNLOCKED
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  OTHER
}

enum PropertyCondition {
  NEW
  GOOD
  RENOVATED
  TO_RENOVATE
}

enum Exposure {
  NORTH
  SOUTH
  EAST
  WEST
  MIXED
}

enum PaymentType {
  LISTING
  IMPROVEMENT
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  password           String
  role               UserRole  @default(USER)
  credits            Int       @default(1)
  improvementCredits Int       @default(0)
  consent            Boolean
  packageId          String?
  package            Package?  @relation(fields: [packageId], references: [id])
  listings           Listing[]
  payments           Payment[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([role])
}

model Package {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  price          Float
  credits        Int
  pricePerCredit Float
  badge          Boolean   @default(false)
  description    String
  features       Json
  isActive       Boolean   @default(true)
  users          User[]
  payments       Payment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Listing {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  location       String
  propertyType   PropertyType
  surface        Float?
  rooms          Float?
  floor          String?
  hasElevator    Boolean?
  rent           Float
  charges        Float?
  parkingPrice   Float?
  condition      PropertyCondition
  exposure       Exposure
  equipment      String?
  availableFrom  DateTime?
  petsAllowed    Boolean?
  proximity      String?
  additionalInfo String?
  title          String?
  description    String?
  highlights     String?
  score          Int?
  status         ListingStatus     @default(DRAFT)
  photos         Photo[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Photo {
  id        String  @id @default(uuid())
  url       String
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
}

model Payment {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  amount    Float
  credits   Int
  type      PaymentType
  stripeId  String
  packageId String?
  package   Package?    @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
}
